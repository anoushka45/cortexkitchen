APP_NAME=CortexKitchen API
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_URL=postgresql://cortex:cortexpass@localhost:5432/cortexkitchen
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

LLM_PROVIDER=groq
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
COMETAPI_KEY=
COMETAPI_MODEL_FAST=deepseek-v4-flash
COMETAPI_MODEL_BALANCED=gemini-3.5-flash
COMETAPI_MODEL_STRONG=claude-sonnet-4-6
